{
  "name": "pawf-server",
  "version": "1.0.0",
  "private": true,
  "description": "Payment Approval & Banking Workflow \u2013 API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/sql','dist/sql',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "DATABASE_URL=postgres://pawf:pawf_dev_pw@localhost:5432/pawf_test tsx --test --test-concurrency=1 test/e2e.test.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed:prod": "node dist/scripts/seed.js",
    "create-admin:prod": "node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}