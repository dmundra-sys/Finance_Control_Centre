# ---------------------------------------------------------------------------
# Payment Approval & Banking Workflow – environment configuration
# Copy to .env (docker compose reads it automatically). NEVER commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Public URL users type in the browser (used in PDF QR codes and e-mail/WhatsApp links)
APP_BASE_URL=https://payments.example.com

# PostgreSQL connection string (docker compose builds this from the POSTGRES_* values below)
DATABASE_URL=postgres://pawf:CHANGE_ME_DB_PASSWORD@localhost:5432/pawf

# 32-byte key, 64 hex characters. Encrypts bank account numbers, 2FA secrets, provider tokens
# and stored documents.  Generate:   openssl rand -hex 32
# !!! Back this key up separately from the database. Without it encrypted data cannot be read. !!!
DATA_ENCRYPTION_KEY=

# Behind HTTPS reverse proxy (nginx, Caddy, load balancer)? Keep both true.
COOKIE_SECURE=true
TRUST_PROXY=true

# Show the one-click demo login list on the login screen. MUST be false in production.
SHOW_DEMO_LOGINS=false

# Where uploaded documents and database backups are written (mount these as volumes)
STORAGE_DIR=/data/storage
BACKUP_DIR=/data/backups

# Optional: secrets can be supplied here instead of the Admin > System settings screen.
# (Values saved on the settings screen are encrypted in the database and take priority.)
# WHATSAPP_ACCESS_TOKEN=
# SMTP_PASSWORD=

# docker compose only
POSTGRES_USER=pawf
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=pawf
